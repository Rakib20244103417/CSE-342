class MetroTicket {
    String passengerName;
    String source;
    String destination;
    boolean roundTrip;
    String seatClass;
    String discountCode;

    // Constructor 1
    MetroTicket(String passengerName, String source, String destination) {
        this(passengerName, source, destination, false);
    }

    // Constructor 2
    MetroTicket(String passengerName, String source,
                String destination, boolean roundTrip) {
        this(passengerName, source, destination, roundTrip, "Regular");
    }

    // Constructor 3
    MetroTicket(String passengerName, String source,
                String destination, boolean roundTrip,
                String seatClass) {
        this(passengerName, source, destination, roundTrip,
             seatClass, "");
    }

    // Constructor 4 (Main Constructor)
    MetroTicket(String passengerName, String source,
                String destination, boolean roundTrip,
                String seatClass, String discountCode) {

        this.passengerName = passengerName;
        this.source = source;
        this.destination = destination;
        this.roundTrip = roundTrip;

        // Validation for seat class
        if (seatClass.equalsIgnoreCase("Regular")
                || seatClass.equalsIgnoreCase("Premium")) {
            this.seatClass = seatClass;
        } else {
            this.seatClass = "Regular";
        }

        this.discountCode = discountCode;
    }

    // Method to calculate fare
    double calculateFare() {
        double fare = 0;

        if (!roundTrip) { // One-way
            if (seatClass.equalsIgnoreCase("Regular"))
                fare = 100;
            else
                fare = 150;
        } else { // Round-trip
            if (seatClass.equalsIgnoreCase("Regular"))
                fare = 180;
            else
                fare = 270;
        }

        // Apply discount
        if (discountCode.equalsIgnoreCase("DIS10")) {
            fare = fare - (fare * 0.10);
        }

        return fare;
    }

    // Display Ticket Details
    void displayTicketDetails() {
        System.out.println("Passenger Name : " + passengerName);
        System.out.println("Source         : " + source);
        System.out.println("Destination    : " + destination);
        System.out.println("Round Trip     : " + roundTrip);
        System.out.println("Seat Class     : " + seatClass);

        if (discountCode.isEmpty())
            System.out.println("Discount Code  : None");
        else
            System.out.println("Discount Code  : " + discountCode);

        System.out.println("Fare           : " + calculateFare());
        System.out.println("-----------------------------------");
    }
}

public class MetroTicketDemo {
    public static void main(String[] args) {

        // Constructor 1
        MetroTicket t1 = new MetroTicket(
                "Rakib", "Dhaka", "Mirpur");

        // Constructor 2
        MetroTicket t2 = new MetroTicket(
                "Hasan", "Uttara", "Farmgate", true);

        // Constructor 3
        MetroTicket t3 = new MetroTicket(
                "Nayeem", "Agargaon", "Motijheel",
                false, "Premium");

        // Constructor 4
        MetroTicket t4 = new MetroTicket(
                "Karim", "Uttara", "Motijheel",
                true, "Premium", "DIS10");

        t1.displayTicketDetails();
        t2.displayTicketDetails();
        t3.displayTicketDetails();
        t4.displayTicketDetails();
    }
}

