public class EvenOddCount {
    public static void main(String[] args) {
        int[] arr = {12, 7, 9, 20, 15, 8, 11};

        int evenCount = 0;
        int oddCount = 0;

        for (int num : arr) {
            if (num % 2 == 0)
                evenCount++;
            else
                oddCount++;
        }

        System.out.println("Even Numbers = " + evenCount);
        System.out.println("Odd Numbers = " + oddCount);
    }
}





  
